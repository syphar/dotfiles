{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.codex/hooks/ccmux-session-start.sh",
            "timeoutSec": 1
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.codex/hooks/ccmux-stop.sh",
            "timeoutSec": 1
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.codex/hooks/ccmux-permission-request.sh",
            "timeoutSec": 1
          }
        ]
      }
    ]
  }
}
